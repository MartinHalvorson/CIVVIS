<?xml version="1.0" encoding="utf-8"?>
<!-- CIVVIS Control: play Civilization VI without a person at the keyboard.
     Separate from CivvisGrounding, which observes AI-only autoplay games and
     must keep working unchanged while this one takes a seat and plays.

     The id must be a syntactically valid GUID. The modding framework parses it
     before it logs anything about the mod, so one non-hex character makes the
     mod disappear from discovery with nothing in any log naming it. -->
<Mod id="4d2c8b16-7e05-49af-a3c1-6b90d5f2e841" version="1">
	<Properties>
		<Name>CIVVIS Control</Name>
		<Teaser>Configures, starts and plays a game under program control.</Teaser>
		<Description>Computer control for Civilization VI. One context configures a game from an exact specification and hosts it from the main menu; the other takes a player's seat and issues every order that player needs, turn after turn, until the game ends. Changes no rules.</Description>
		<Authors>CIVVIS</Authors>
		<!-- Loaded from the install's DLC tree, which this build scans; no user
		     Mods directory is scanned. Enabled by default so an unattended run
		     needs no menu interaction. -->
		<EnabledByDefault>1</EnabledByDefault>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>
	<!-- Load after the UI mods whose replacement scripts this mod chains. Both
	     references are soft: they order the load when the optional mod is
	     present and are ignored when it is not. Without the first reference,
	     GranColombia_Maya's NaturalDisasterPopup replacement won and this
	     closer never armed for that context. Sukritact's Simple UI Adjustments
	     has the same conflict for WonderBuiltPopup; its replacement also adds
	     the wonder audio, so the closer chains it rather than silently dropping
	     that behavior. -->
	<References>
		<Mod id="9DE86512-DE1A-400D-8C0A-AB46EBBF76B9" title="GranColombia_Maya"/>
		<Mod id="805cc499-c534-4e0a-bdce-32fb3c53ba38" title="Sukritact's Simple UI Adjustments"/>
	</References>
	<FrontEndActions>
		<!-- ⚠ `AddUserInterfaces` with `<Context>FrontEnd</Context>` USED TO BE HERE and
		     never loaded: across 38 shipped DLC that pattern appears in FrontEndActions
		     ZERO times (and in InGameActions nine times). That single dead hook is why
		     `setup: "(absent)"` appears in every seat event, and therefore why MapScript,
		     Leader and MapSeed have never applied. `UpdateDatabase` is what shipped DLC
		     actually use here, and the Create Game screen is driven by the configuration
		     DATABASE rather than by Lua — so the defaults are reachable as data. -->
		<UpdateDatabase id="CivvisControlSetupDefaults">
			<File>CivvisControlConfig.xml</File>
		</UpdateDatabase>
	</FrontEndActions>
	<InGameActions>
		<AddUserInterfaces id="CivvisControlAgentUI">
			<Properties>
				<Context>InGame</Context>
			</Properties>
			<File>CivvisControlAgent.xml</File>
		</AddUserInterfaces>
		<!-- The game's announcement screens hold the world until somebody
		     dismisses them, and nobody is at the keyboard. Each one below is
		     pointed at the same replacement, which loads the shipped screen and
		     gives it a stopwatch; CivvisControlAutoClose.lua says why these
		     screens and no others.

		     A LuaReplace file must also be imported. A file listed only under
		     <Files> is not in the virtual file system, so the replacement
		     resolves to nothing and the screen loses its script altogether:
		     the same trap that silently emptied the settings prelude. -->
		<ImportFiles id="CivvisControlAutoCloseFiles">
			<File>CivvisControlAutoClose.lua</File>
		</ImportFiles>
		<!-- ★★★★ THE END OF THE GAME, WHICH WAS BEING LOGGED AS A STALL.
		     Run civvis-20260730T211350Z was photographed showing Civilization
		     VI's DEFEAT screen for the Swedish Empire at turn 144, and the
		     ledger recorded `reason: "stalled: no event for 240s"` with
		     `outcome: null` — a loss and a hang are indistinguishable in the
		     one column the ladder exists to fill.

		     The cause is that this screen HALTS THE GAME CORE the way the era
		     screens do, so the agent's own 0-cities defeat check never gets
		     another turn to run: the empire still held one city on the last
		     turn it managed to export. Registering the screen here makes it
		     announce itself through the shim's `screen` field, so the run ends
		     with evidence instead of silence.

		     ⚠ Deliberately NOT relied on for won/lost. The shim reports which
		     screen it closed, not who won; `won()` still requires the mod's own
		     victory event naming us, because a rival's victory raises this same
		     screen and recording that as ours would be the worst possible bug. -->
		<ReplaceUIScript id="CivvisControlAutoCloseEndGameMenu">
			<Properties>
				<LuaContext>EndGameMenu</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseDiplomacyActionView">
			<Properties>
				<LuaContext>DiplomacyActionView</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- The trade and deal screens. A rival opening a deal lays a
		     full-screen table over the map and leaves it there, so these
		     block the view exactly as the congress screens did.
		     DiplomacyDealView is the one an AI proposal raises. -->
		<ReplaceUIScript id="CivvisControlAutoCloseDiplomacyDealView">
			<Properties>
				<LuaContext>DiplomacyDealView</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- Spy mission briefings/results are informational overlays once the
		     controller has issued its order. An escape route is a genuine blocker,
		     so the shared closer uses its always-available city-center response
		     instead of merely hiding it and letting it cover the map again. -->
		<ReplaceUIScript id="CivvisControlAutoCloseEspionagePopup">
			<Properties>
				<LuaContext>EspionagePopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseEspionageEscape">
			<Properties>
				<LuaContext>EspionageEscape</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- The relic screens, reported sitting over the map. Neither
		     exposes OnClose or Close; their buttons call OnHideScreen and
		     OnButton1, which the shim now tries. -->
		<ReplaceUIScript id="CivvisControlAutoCloseGreatWorkShowcase">
			<Properties>
				<LuaContext>GreatWorkShowcase</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseChooseArtifact">
			<Properties>
				<LuaContext>ChooseArtifact</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseTradeOverview">
			<Properties>
				<LuaContext>TradeOverview</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseTradeRouteChooser">
			<Properties>
				<LuaContext>TradeRouteChooser</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseLeaderView">
			<Properties>
				<LuaContext>LeaderView</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseHistoricMoments">
			<Properties>
				<LuaContext>HistoricMoments</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseEraProgressPanel">
			<Properties>
				<LuaContext>EraProgressPanel</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseWorldCongressIntro">
			<Properties>
				<LuaContext>WorldCongressIntro</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<!-- A special-session notification (including a military emergency)
		     opens WorldCongressPopup itself, not the intro or between-turns
		     contexts.  Leaving this context out meant the map could remain
		     covered until the operator pressed Pass by hand. -->
		<ReplaceUIScript id="CivvisControlAutoCloseWorldCongressPopup">
			<Properties>
				<LuaContext>WorldCongressPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseWorldCongressBetweenTurns">
			<Properties>
				<LuaContext>WorldCongressBetweenTurns</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseWorldCongressPopup">
			<Properties>
				<LuaContext>WorldCongressPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseDedicationPopup">
			<Properties>
				<LuaContext>DedicationPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseEraReviewPopup">
			<Properties>
				<LuaContext>EraReviewPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseWonderBuilt">
			<Properties>
				<LuaContext>WonderBuiltPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
				<!-- Sukritact and several UI packs use LoadOrder 10 for this
				     context. Keep this wrapper last so a completed wonder cannot
				     bypass the native close path again. -->
				<LoadOrder>100000</LoadOrder>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseNaturalWonder">
			<Properties>
				<LuaContext>NaturalWonderPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseEraComplete">
			<Properties>
				<LuaContext>EraCompletePopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseEraReview">
			<Properties>
				<LuaContext>EraReviewPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseTechCivicCompleted">
			<Properties>
				<LuaContext>TechCivicCompletedPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseBoostUnlocked">
			<Properties>
				<LuaContext>BoostUnlockedPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseProjectBuilt">
			<Properties>
				<LuaContext>ProjectBuiltPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseNaturalDisaster">
			<Properties>
				<LuaContext>NaturalDisasterPopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseInGamePopup">
			<Properties>
				<LuaContext>InGamePopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
		<ReplaceUIScript id="CivvisControlAutoCloseRockBandMovie">
			<Properties>
				<LuaContext>RockBandMoviePopup</LuaContext>
				<LuaReplace>CivvisControlAutoClose.lua</LuaReplace>
			</Properties>
		</ReplaceUIScript>
	</InGameActions>
	<Files>
		<!-- ⚠ EVERY FILE AN ACTION REFERENCES MUST BE LISTED HERE, or the game logs
		     "Invalid file reference in action, did you forgot to add it in <Files>?"
		     and silently drops that action. CivvisControlConfig.xml was missing, so the
		     whole setup-defaults UpdateDatabase never ran and the seat kept reporting
		     Continents — the change was correct and simply never loaded. The game names
		     this in Modding.log; grep it before theorising about a mechanism. -->
		<File>CivvisControlConfig.xml</File>
		<File>CivvisControlSetup.xml</File>
		<File>CivvisControlSetup.lua</File>
		<File>CivvisControlAgent.xml</File>
		<File>CivvisControlAgent.lua</File>
		<File>CivvisControlAutoClose.lua</File>
	</Files>
</Mod>
