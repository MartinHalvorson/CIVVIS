<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.civvis.run-prune — hourly retention for ~/civvis-civ6-runs/control.
  Runs tools/ops/civvis-run-prune.sh every hour: run directories older than 24 h
  are removed (operator rule, 2026-08-31), never the ledgers beside them or a
  run a process has open. Read the script's header
  before installing it on a host that keeps event streams for analysis.

  This is a TEMPLATE. tools/ops/civvis-install-host-automation.sh renders the
  two placeholders (__HOME__, __OPS__ = the tracked tools/ops directory) and
  loads the result into ~/Library/LaunchAgents; do not copy it by hand.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.civvis.run-prune</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__OPS__/civvis-run-prune.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/civvis-run-prune-agent.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/civvis-run-prune-agent.log</string>
</dict>
</plist>
