<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.civvis.keepplaying — the operator's standing intent, checked every five
  minutes. `civvis-games ensure` clears a forgotten halt and restarts the
  ladder chain when nothing is playing, but only while
  ~/.civvis-operator-intent says `running` (`civvis-games off` writes `stopped`).

  This is a TEMPLATE. tools/ops/civvis-install-host-automation.sh renders the
  two placeholders (__HOME__, __OPS__ = the tracked tools/ops directory) and
  loads the result into ~/Library/LaunchAgents; do not copy it by hand.

  It does not run the game itself — the loop must start through Terminal, which
  holds the grants launchd lacks (see tools/ops/ladder_watchdog.py); `ensure`
  asks Terminal to open the operator wrapper.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.civvis.keepplaying</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__OPS__/civvis-games.sh</string>
		<string>ensure</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/civvis-keepplaying.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/civvis-keepplaying.log</string>
</dict>
</plist>
