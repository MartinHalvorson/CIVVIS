<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.civvis.worktree-prune — hourly retention for finished CIVVIS task trees.
  Runs tools/ops/civvis-worktree-prune.sh every hour.  The wrapper only removes
  clean agent worktrees that have been inactive for 24 h and whose content
  GitHub can reach; it explicitly leaves dirty, live, main, and deployment
  trees alone.  See tools/civvis_worktree_audit.py before changing that bar.

  This is a TEMPLATE. tools/ops/civvis-install-host-automation.sh renders the
  two placeholders (__HOME__, __OPS__ = the tracked tools/ops directory) and
  loads the result into ~/Library/LaunchAgents; do not copy it by hand.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.civvis.worktree-prune</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__OPS__/civvis-worktree-prune.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/civvis-worktree-prune-agent.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/civvis-worktree-prune-agent.log</string>
</dict>
</plist>
