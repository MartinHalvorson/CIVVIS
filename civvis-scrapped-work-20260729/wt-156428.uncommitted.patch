+// Which tile lies across each of a tile's own edges, read off the geometry
+// once. Two cells share exactly two corners, so a corner pair names the seam
+// between them and nothing else. A frontier needs this for the whole globe and
+// not just the half in the picture: a border exists where the tile on the
+// *other* side is held by somebody else, and that tile is often over the
+// horizon.
+function linkPlanetCells(cells) {
+  const seams = new Map();
+  for (const [cellKey, cell] of cells) {
+    const ids = cell.ids;
+    for (let i = 0; i < ids.length; i++) {
+      const a = ids[i], b = ids[(i + 1) % ids.length];
+      const seam = a < b ? a + "_" + b : b + "_" + a;
+      const first = seams.get(seam);
+      if (first === undefined) { seams.set(seam, [cellKey, i]); continue; }
+      cell.nbrs[i] = first[0];
+      cells.get(first[0]).nbrs[first[1]] = cellKey;
+    }
+  }
+}
