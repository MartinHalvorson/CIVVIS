+                            && after
+                                .rules
+                                .units
+                                .get(other.kind.as_str())
+                                .is_some_and(|spec| spec.is_melee_capable())
+                            && after.wdist(other.pos, after_city.pos) <= 1
+                    });
+                    if !taker_ready {
+                        value -= 30.0;
+                    }
+                }
