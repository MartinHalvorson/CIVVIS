+// TEMPORARY gold-audit instrumentation (scratch worktree only).
+thread_local! {
+    pub static GOLD_TRACE: std::cell::RefCell<Option<Vec<(&'static str, f64)>>> =
+        const { std::cell::RefCell::new(None) };
+}
+pub fn gold_trace_on() {
+    GOLD_TRACE.with(|t| *t.borrow_mut() = Some(Vec::new()));
+}
+pub fn gold_trace_take() -> Vec<(&'static str, f64)> {
+    GOLD_TRACE.with(|t| t.borrow_mut().take().unwrap_or_default())
+}
+fn gold_mark(label: &'static str, value: f64) {
+    GOLD_TRACE.with(|t| {
+        if let Some(v) = t.borrow_mut().as_mut() {
+            v.push((label, value));
+        }
+    });
+}
